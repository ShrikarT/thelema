# Server only. Copy to .env; never commit secrets. No private keys are required by the web server.
HOST=127.0.0.1
PORT=3000
# For a reviewed hosted environment set the exact origin and host.
APP_ORIGIN=http://127.0.0.1:3000
APP_HOST=127.0.0.1:3000
# Arc Testnet addresses from a real, verified deployment. Leave blank until deployed.
ARC_BINARY_AMM=
ARC_YES_SHARE_AMM=
ARC_NO_SHARE_AMM=
ARC_BINARY_VAULT=
ARC_SHARE_VAULT=
ARC_ORACLE=
# Graph schema templates MUST be verified against the chosen deployed subgraphs.
GRAPH_API_KEY=
GRAPH_PROBABILITY_SUBGRAPH_ID=Bx1W4S7kDVxs9gC3s2G6DS8kdNBJNVhMviCtin2DiBp
GRAPH_PROBABILITY_MARKET_ID=
GRAPH_YES_INDEX=0
# Verified live spot pool on Ethereum via The Graph Decentralized Gateway:
# Subgraph: 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV (Uniswap v3)
# Pool: 0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640 (USDC/WETH 0.05%)
GRAPH_SPOT_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_SPOT_POOL_ID=0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640
GRAPH_SPOT_TOKEN_SYMBOL=WETH
GRAPH_SPOT_ASSET=ETH
GRAPH_SPOT_COMPARABLE=false
GRAPH_SPOT_SCHEMA=uniswap3
GRAPH_MAX_AGE_SECONDS=900
# Operator-owned HTTPS bridge to an authenticated CRE confidential workflow.
CRE_CLIP_URL=
CRE_CLIP_ALLOWED_HOST=
CRE_CLIP_TOKEN=
# MAX_NOTIONAL belongs in CRE secret storage, NOT this web environment or the client.

# CRE_CLIP_URL should point to https://<approved-bridge-host>/v1/clip.
# CRE_CLIP_TOKEN must match the separately hosted bridge's BRIDGE_AUTH_TOKEN.
# Generate at least 32 random bytes; never place the CRE signing key in this web environment.
