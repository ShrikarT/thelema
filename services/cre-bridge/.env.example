# Bridge process only. Inject using the hosting secret manager or --env-file.
# Do NOT copy the signing key into the web app, n8n evidence form, chat or source control.
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_AUTH_TOKEN=
# Match this token with CRE_CLIP_TOKEN in the web-server environment.
CRE_CALLBACK_URL=
# Exact form: https://your-approved-bridge-host/v1/callback (TLS proxy preserves Host).
CRE_GATEWAY_REGISTRY=private
CRE_WORKFLOW_ID=
# 64 hex characters, no 0x. Use a genuinely deployed confidential workflow.
CRE_TRIGGER_SIGNER=
CRE_TRIGGER_PRIVATE_KEY=
# Prefer a dedicated zero-balance trigger signer, not the Arc deployer or trading wallet.
# MAX_NOTIONAL remains ONLY in CRE secret storage.
