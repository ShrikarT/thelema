{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelema.invalid/schemas/release-evidence.schema.json",
  "title": "THELEMA release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["gitSha", "branch", "unitStatus", "buildStatus", "uiStatus", "foundryStatus", "arc", "graph", "cre", "humanApproval"],
  "properties": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "unitStatus": {"const": "PASS"},
    "buildStatus": {"const": "PASS"},
    "uiStatus": {"const": "PASS"},
    "foundryStatus": {"const": "PASS"},
    "arc": {"type": "object", "additionalProperties": false, "required": ["receiptUrl"], "properties": {"receiptUrl": {"type": "string", "minLength": 1}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["liveEvidenceUrl"], "properties": {"liveEvidenceUrl": {"type": "string", "minLength": 1}}},
    "cre": {"type": "object", "additionalProperties": false, "required": ["simulationStatus", "evidenceUrl"], "properties": {"simulationStatus": {"const": "PASS"}, "evidenceUrl": {"type": "string", "minLength": 1}}},
    "humanApproval": {"type": "object", "additionalProperties": false, "required": ["status", "reference"], "properties": {"status": {"const": "APPROVED"}, "reference": {"type": "string", "minLength": 1}}}
  }
}
